[
    {
        "label": "Build",
        "command": "./build.bat",
        "cwd": "${ZED_WORKTREE_ROOT}",
        "reveal": "no_focus",
        "hide": "on_success",
    },
    {
        "label": "Debug_External",
        "command": "raddbg",
        "args": ["--project:.raddbg", "--auto_run", "-q"],
        "cwd": "${ZED_WORKTREE_ROOT}",
        "reveal": "never",
        "hide": "always",
    },
]
