{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Misery",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "",
            "windows": {
                "program": "${workspaceFolder}/Binaries/windows-x64-dbg/Misery.exe"
            },
            "linux": {
                "program": "${workspaceFolder}/Binaries/linux-x64-dbg/Misery"
            },
            "osx": {
                "program": "${workspaceFolder}/Binaries/osx-x64-dbg/Misery"
            },
            "preLaunchTask": "Build",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "logging": {
                "engineLogging": false,
                "moduleLoad": false,
                "exceptions": true,
                "processExit": true,
                "programOutput": true,
                "threadExit": true
            },
            "visualizerFile": "${workspaceFolder}/Binaries/windows-x64-dbg/Natvis/Core.natvis"
        },
        {
            "name": "Brahma Build Tool (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "",
            "windows": {
                "program": "${workspaceFolder}/Intermediate/__Brahma/brahma.exe"
            },
            "linux": {
                "program": "${workspaceFolder}/Intermediate/__Brahma/brahma"
            },
            "osx": {
                "program": "${workspaceFolder}/Intermediate/__Brahma/brahma"
            },
            "preLaunchTask": "Build Debuggable Build Tool",
            "args": [
                "-intermediate_output",
                "${workspaceFolder}/Intermediate/__Brahma",
                "-out",
                "${workspaceFolder}/Binaries",
                "-warnings",
                "-warn_as_err"
            ],
            "cwd": "${workspaceFolder}",
            "logging": {
                "engineLogging": false,
                "moduleLoad": false,
                "exceptions": true,
                "processExit": true,
                "programOutput": true,
                "threadExit": true
            }
        }
    ]
}